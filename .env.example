# ai-ml-study 설정 템플릿
# 이 파일을 .env 로 복사해서 사용하세요:
#   Windows      : copy .env.example .env
#   macOS/Linux  : cp .env.example .env
#
# scripts/*.ps1 (Windows) 와 scripts/*.sh (macOS/Linux) 가 .env 를 자동으로 로드합니다.

# ── 로컬 실행 ────────────────────────────────────────────────
# 로컬에서만 쓸 때는 아래 값 그대로 두면 됩니다.

# 안내 URL에 사용할 호스트. 로컬 전용이면 localhost.
#   - 비워두면 install-service.sh 가 클라우드 메타데이터의 외부 IP를 자동 조회하고,
#     실패 시 내부 IP로 폴백합니다.
PUBLIC_HOST=localhost

# 정적 서버 포트. scripts/serve.ps1 과 install-service.sh 가 사용합니다.
# 스크립트 인자로 넘기면 그 값이 우선합니다.
PORT=8080

# quarto preview 포트. scripts/preview.ps1 / preview.sh 가 사용합니다.
# 비워두면 quarto 가 빈 포트를 자동으로 선택합니다.
PREVIEW_PORT=

# ── 원격 배포 (Linux + systemd) ──────────────────────────────
# 서버에 배포할 때는 PUBLIC_HOST 에 고정 도메인/고정 IP를 지정하거나
# (예: PUBLIC_HOST=aiml.example.com) 비워두고 자동 조회에 맡기세요.
